# =============================================================
# CryptoMind / TON — Production Environment Template
# -------------------------------------------------------------
# 這是「部署範本」，所有值都是 placeholder。複製成實際的 .env.production
# （或 Zeabur 的環境變數）後，逐項填入真實值。
#
# ⚠️ 嚴禁把真實密鑰 commit 進 git。本檔案已被 .gitignore 的
#    *.production.template 覆蓋（見下方確認），但請勿以任何形式將
#    填好值的版本加入版本庫。
#
# 機密來源：只能由部署平台／secret manager 注入；正式環境必須設定
# JWT_SECRET_KEY 與 API_KEY_ENCRYPTION_SECRET（各 ≥ 32 字元），
# 否則應用程式會拒絕啟動。
# =============================================================

# === Application ===
ENVIRONMENT=production
APP_LOG_LEVEL=WARNING
WEB_CONCURRENCY=1
# 明確的 HTTPS origins，禁止 *
CORS_ORIGINS=https://cryptomind-ton.zeabur.app/
ALLOWED_HOSTS=cryptomind-ton.zeabur.app
COOKIE_DOMAIN=
LOG_FORMAT=text

# === Database (Required) ===
# Zeabur 上用 service reference 綁定（如 ${POSTGRES_URI}），自架則填完整 URL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# === Security (Required — generate with: openssl rand -hex 32) ===
JWT_SECRET_KEY=***
API_KEY_ENCRYPTION_SECRET=***

# === Redis (Required in production) ===
# Zeabur 上用 service reference（如 ${REDIS_URL}），自架則填完整 URL
REDIS_URL=redis://:PASSWORD@HOST:6379/0

# === LLM Providers (BYOK 為主；以下為 server 端 fallback，選填) ===
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
GROQ_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MINIMAX_API_KEY=
VOLCENGINE_API_KEY=
NVIDIA_API_KEY=

# === Langfuse (LLM Observability — optional, leave blank to disable) ===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# === BYOK Fallback (optional, disabled by default — 會產生伺服器成本) ===
BYOK_FALLBACK_ENABLED=false
BYOK_FALLBACK_PROVIDER=openai
BYOK_FALLBACK_MODEL=gpt-4o-mini
BYOK_FALLBACK_API_KEY=

# === TON Network ===
TON_NETWORK=mainnet
TON_RECEIVING_ADDRESS_TESTNET=0Q***
TON_RECEIVING_ADDRESS_MAINNET=UQ***
TONCENTER_API_KEY=
TON_MANIFEST_URL=https://cryptomind-ton.zeabur.app
TON_PRICE_PREMIUM_MONTHLY=0.3
TON_PRICE_PREMIUM_YEARLY=3.0
TON_PRICE_CREATE_POST=0.1
TON_PRICE_TIP=0.1
# 主網 hardening：把登入 proof 公鑰綁定到鏈上錢包公鑰，擋偽造
TON_PROOF_REQUIRE_ONCHAIN_PUBKEY=true

# === OKX Exchange ===
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# === Test Mode (MUST be false in production) ===
TEST_MODE=false

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
BOT_INTERNAL_SECRET=***
TELEGRAM_BOT_MODE=webhook
# bot 服務打 API service 的內部 URL
API_BASE_URL=http://app:8080
TELEGRAM_WEBAPP_URL=https://cryptomind-ton.zeabur.app

# === SSL Verification ===
SSL_VERIFY=true

# === Lifespan / Startup（生產環境 Zeabur 特有 tuning）===
# entrypoint 已跑過 alembic，lifespan 內跳過（避免重跑卡住）
LIFESPAN_SKIP_ALEMBIC=true
SKIP_DB_INIT=false
ORM_AUTO_MIGRATE=true
GUNICORN_LOG_LEVEL=warning

# === Background workers（卸載到外部 worker，避免佔用 web worker）===
# 1 = 由獨立 cron-worker 服務負責；web 服務啟動時跳過
SCREENER_WORKER=1
MARKET_PULSE_WORKER=1
FUNDING_RATE_WORKER=1
PRICE_ALERT_WORKER=1

# === GoPlus Security ===
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# === Email (optional) ===
SMTP_EMAIL=
SMTP_PASSWORD=
RESET_URL_BASE=https://cryptomind-ton.zeabur.app

# === Omniston Swap（換幣功能）===
# ⚠️ Production 預設關閉（config guard：ENVIRONMENT=production 時 OMNISTON_ENABLED 預設 false）。
# 要啟用換幣須「顯式」設 true。碰真錢功能不靠 silent default 開啟。
OMNISTON_ENABLED=false
OMNISTON_WS_URL=wss://omni-ws.ston.fi
OMNISTON_REQUEST_TIMEOUT=15
# Swap 單筆上限（USD）。灰度期 50；往上調需先完成 trust.py 分級。
SWAP_MAX_USD=50
SWAP_TON_PRICE_CACHE_TTL=60
SWAP_ORDER_TTL=180
