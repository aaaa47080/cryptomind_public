{
  "name": "stock-agent-frontend",
  "version": "1.0.0",
  "description": "Frontend build scripts for Pi Crypto Insight",
  "scripts": {
    "build:css": "npx tailwindcss -i ./web/css/tailwind-src.css -o ./web/css/tailwind-built.css --minify",
    "watch:css": "npx tailwindcss -i ./web/css/tailwind-src.css -o ./web/css/tailwind-built.css --watch",
    "dev": "vite",
    "build": "npm run build:css && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.8",
    "vite-plugin-pwa": "^1.3.0"
  },
  "main": "tailwind.config.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aaaa47080/stock_agent.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/aaaa47080/stock_agent/issues"
  },
  "homepage": "https://github.com/aaaa47080/stock_agent#readme",
  "overrides": {
    "picomatch": "^4.0.4"
  }
}